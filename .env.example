# Select the adapter: bybit or binance
EXCHANGE=bybit

# Bybit Mainnet credentials (preserved when using the separate Testnet pair)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
# Separate testnet credentials, used only when BYBIT_TESTNET=true.
# Keep the mainnet pair above; fill this pair with your Testnet credentials.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Binance USD-M Futures credentials (separate Testnet and Mainnet keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

DRY_RUN=true
TRADING_ENABLED=false
LIVE_TRADING_CONFIRM=

# Trading defaults
BYBIT_CATEGORY=linear
BYBIT_SYMBOL=BTCUSDT
BYBIT_INTERVAL=15
