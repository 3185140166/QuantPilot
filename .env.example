# Select the adapter: bybit or binance
EXCHANGE=bybit

# Bybit API credentials (create separate keys for Testnet and Mainnet)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Binance USD-M Futures credentials (separate Testnet and Mainnet keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

DRY_RUN=true
TRADING_ENABLED=false
LIVE_TRADING_CONFIRM=

# Trading defaults
BYBIT_CATEGORY=linear
BYBIT_SYMBOL=BTCUSDT
BYBIT_INTERVAL=15
