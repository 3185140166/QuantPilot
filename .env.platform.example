# Separate platform configuration. Exchange credentials remain in .env.
DATABASE_URL=sqlite:///storage/platform.db
# Personal local mode opens directly; set true to enable the optional access gate.
PLATFORM_AUTH_ENABLED=false
# Only required when PLATFORM_AUTH_ENABLED=true.
PLATFORM_ACCESS_TOKEN=
# demo uses synthetic prices; exchange uses the environments selected in .env.
PLATFORM_MARKET_SOURCE=demo
PLATFORM_POLL_SECONDS=10
# Enables the Bybit assistant for the active environment; legacy variable name retained.
# Mainnet additionally requires LIVE_TRADING_CONFIRM in .env and manual start.
PLATFORM_TESTNET_EXECUTION_ENABLED=true
PLATFORM_TESTNET_STREAM_ENABLED=true
# Unified launcher: online SQLite backups, retained snapshots and bounded restarts.
PLATFORM_BACKUP_HOURS=24
PLATFORM_BACKUP_KEEP=7
PLATFORM_RESTART_LIMIT=5
# Docker Compose requires a database password (set only when using Docker).
POSTGRES_PASSWORD=
